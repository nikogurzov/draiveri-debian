#!/bin/sh
set -e
if [ "$1" = configure ]; then
    # старите копия от install.sh (/opt/draiveri, /opt/drv-marka) иначе засенчват новото в PATH
    for n in draiveri drv-marka; do
        if [ -L /usr/local/bin/$n ] && [ "$(readlink /usr/local/bin/$n)" = /opt/$n/$n.py ]; then
            rm -f /usr/local/bin/$n
        fi
        if [ -f /opt/$n/jezgro.py ] && [ -f /opt/$n/popravi.py ]; then
            rm -rf /opt/$n
        fi
    done
    # програмата се казваше „draiveri“: историята (за „Върни“) и старите извори се пренасят на новото място
    for d in lib backups; do
        if [ -d /var/$d/draiveri ] && [ ! -e /var/$d/drv-marka ]; then
            mv /var/$d/draiveri /var/$d/drv-marka
        fi
    done
fi
exit 0
